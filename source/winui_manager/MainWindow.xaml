<Window
    x:Class="G3Companion.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="G3 Companion">
    <Grid x:Name="RootGrid"
          Background="Transparent"
          SizeChanged="Root_SizeChanged"
          KeyDown="Root_KeyDown">
        <Grid.Resources>
            <ResourceDictionary>
                <ResourceDictionary.ThemeDictionaries>
                    <ResourceDictionary x:Key="Light">
                        <SolidColorBrush x:Key="SettingsPageBackgroundBrush" Color="White" Opacity="0.65"/>
                        <Color x:Key="ClockCalibrationIdleFillColor">#FFD9D9D9</Color>
                    </ResourceDictionary>
                    <ResourceDictionary x:Key="Default">
                        <SolidColorBrush x:Key="SettingsPageBackgroundBrush" Color="Black" Opacity="0.35"/>
                        <StaticResource x:Key="ClockCalibrationIdleFillColor" ResourceKey="ControlFillColorSecondary"/>
                    </ResourceDictionary>
                    <ResourceDictionary x:Key="HighContrast">
                        <SolidColorBrush x:Key="SettingsPageBackgroundBrush" Color="{ThemeResource SystemColorWindowColor}"/>
                        <StaticResource x:Key="ClockCalibrationIdleFillColor" ResourceKey="SystemColorButtonFaceColor"/>
                    </ResourceDictionary>
                </ResourceDictionary.ThemeDictionaries>
            <x:Double x:Key="TitleBarCompactHeight">32</x:Double>
            <x:Double x:Key="TitleBarExpandedHeight">32</x:Double>
            <x:Double x:Key="TitleBarLeftPaddingWidth">0</x:Double>
            <x:Double x:Key="TitleBarLeftHeaderPaddingWidth">0</x:Double>
            <x:Double x:Key="TitleBarHeaderNegativeInsetPaddingWidth">0</x:Double>
            <x:Double x:Key="TitleBarMinDragRegionWidth">0</x:Double>
            <SolidColorBrush x:Key="MacroAccentBrush" Color="{ThemeResource SystemAccentColor}"/>
            <SolidColorBrush x:Key="ClockCalibrationIdleFillBrush" Color="{ThemeResource ClockCalibrationIdleFillColor}"/>
            <SolidColorBrush x:Key="MacroSecondaryBrush" Color="{ThemeResource TextFillColorSecondary}"/>
            <SolidColorBrush x:Key="MacroInvertedBrush" Color="{ThemeResource TextOnAccentFillColorPrimary}"/>
            <SolidColorBrush x:Key="MacroCriticalBrush" Color="{ThemeResource SystemFillColorCritical}"/>
            <SolidColorBrush x:Key="PageBackgroundBrush" Color="{ThemeResource SolidBackgroundFillColorBase}"/>
            <SolidColorBrush x:Key="ExpandedBatteryTextBrush" Color="{ThemeResource TextFillColorPrimary}"/>
            <SolidColorBrush x:Key="CompactBatteryTextBrush" Color="{ThemeResource TextFillColorSecondary}"/>
            <ResourceDictionary x:Key="DpiColorButtonResources">
                <ResourceDictionary.ThemeDictionaries>
                    <ResourceDictionary x:Key="Default">
                        <SolidColorBrush x:Key="ButtonBorderBrush" Color="{ThemeResource ControlStrongStrokeColorDefault}"/>
                        <SolidColorBrush x:Key="ButtonBorderBrushPointerOver" Color="{ThemeResource SystemAccentColorDark1}"/>
                        <SolidColorBrush x:Key="ButtonBorderBrushPressed" Color="{ThemeResource SystemAccentColorDark2}"/>
                    </ResourceDictionary>
                    <ResourceDictionary x:Key="Dark">
                        <SolidColorBrush x:Key="ButtonBorderBrush" Color="{ThemeResource ControlStrongStrokeColorDefault}"/>
                        <SolidColorBrush x:Key="ButtonBorderBrushPointerOver" Color="{ThemeResource SystemAccentColorLight2}"/>
                        <SolidColorBrush x:Key="ButtonBorderBrushPressed" Color="{ThemeResource SystemAccentColorLight1}"/>
                    </ResourceDictionary>
                    <ResourceDictionary x:Key="HighContrast">
                        <SolidColorBrush x:Key="ButtonBorderBrush" Color="{ThemeResource SystemColorButtonTextColor}"/>
                        <SolidColorBrush x:Key="ButtonBorderBrushPointerOver" Color="{ThemeResource SystemColorHighlightColor}"/>
                        <SolidColorBrush x:Key="ButtonBorderBrushPressed" Color="{ThemeResource SystemColorHighlightTextColor}"/>
                    </ResourceDictionary>
                </ResourceDictionary.ThemeDictionaries>
            </ResourceDictionary>
            <SolidColorBrush x:Key="NavigationViewContentBackground" Color="Transparent"/>
            <SolidColorBrush x:Key="NavigationViewDefaultPaneBackground" Color="Transparent"/>
            <Thickness x:Key="NavigationViewPaneContentGridMargin">0,3,0,0</Thickness>
            <Style x:Key="SettingsCardStyle" TargetType="Border">
                <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}"/>
                <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="CornerRadius" Value="8"/>
            </Style>
            <Style x:Key="SettingsRowStyle" TargetType="Border">
                <Setter Property="Padding" Value="20,8"/>
                <Setter Property="MinHeight" Value="50"/>
            </Style>
            <Style x:Key="SettingsSeparatorStyle" TargetType="Border">
                <Setter Property="Height" Value="1"/>
                <Setter Property="Background" Value="{ThemeResource CardStrokeColorDefaultBrush}"/>
            </Style>
            <!-- Native determinate ProgressBar parts, declared without reposition transitions.
                 Configure the template before loading; modifying live VSM collections is unsafe. -->
            <Style x:Key="ButtonResetCountdownStyle" TargetType="ProgressBar">
                <Setter Property="Foreground" Value="{ThemeResource ProgressBarForeground}"/>
                <Setter Property="Background" Value="{ThemeResource ProgressBarBackground}"/>
                <Setter Property="BorderBrush" Value="{ThemeResource ProgressBarBorderBrush}"/>
                <Setter Property="BorderThickness" Value="{ThemeResource ProgressBarBorderThemeThickness}"/>
                <Setter Property="MinHeight" Value="3"/>
                <Setter Property="CornerRadius" Value="1.5"/>
                <Setter Property="IsTabStop" Value="False"/>
                <Setter Property="VerticalAlignment" Value="Center"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ProgressBar">
                            <Grid x:Name="LayoutRoot">
                                <VisualStateManager.VisualStateGroups>
                                    <VisualStateGroup x:Name="CommonStates">
                                        <VisualState x:Name="Normal"/>
                                        <VisualState x:Name="Determinate"/>
                                        <VisualState x:Name="Updating"/>
                                    </VisualStateGroup>
                                </VisualStateManager.VisualStateGroups>
                                <Border x:Name="ProgressBarRoot" BorderBrush="{TemplateBinding BorderBrush}"
                                        BorderThickness="{TemplateBinding BorderThickness}" Padding="{TemplateBinding Padding}"
                                        CornerRadius="{TemplateBinding CornerRadius}">
                                    <Border Clip="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=TemplateSettings.ClipRect}">
                                        <Grid Height="{TemplateBinding MinHeight}">
                                            <Rectangle x:Name="ProgressBarTrack" Fill="{TemplateBinding Background}"
                                                       Height="1" VerticalAlignment="Center" RadiusX="0.5" RadiusY="0.5"/>
                                            <Rectangle x:Name="DeterminateProgressBarIndicator" Fill="{TemplateBinding Foreground}"
                                                       HorizontalAlignment="Left" RadiusX="1.5" RadiusY="1.5"/>
                                        </Grid>
                                    </Border>
                                </Border>
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
            <Style x:Key="DpiStageIndicatorStyle" TargetType="Border">
                <Setter Property="Width" Value="3"/>
                <Setter Property="Height" Value="16"/>
                <Setter Property="CornerRadius" Value="1.5"/>
                <Setter Property="Background" Value="{ThemeResource NavigationViewSelectionIndicatorForeground}"/>
                <Setter Property="HorizontalAlignment" Value="Left"/>
                <Setter Property="VerticalAlignment" Value="Center"/>
                <Setter Property="IsHitTestVisible" Value="False"/>
            </Style>
            <Style x:Key="SettingLabelStyle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="14"/>
                <Setter Property="FontWeight" Value="Normal"/>
                <Setter Property="VerticalAlignment" Value="Center"/>
            </Style>
            <Style x:Key="UsagePastBarStyle" TargetType="Border">
                <Setter Property="Background" Value="{ThemeResource TextFillColorSecondaryBrush}"/>
                <Setter Property="Opacity" Value="0.55"/>
            </Style>
            <Style x:Key="UsageTodayBarStyle" TargetType="Border">
                <Setter Property="Background" Value="{ThemeResource AccentFillColorDefaultBrush}"/>
            </Style>
            <Style x:Key="UsagePastDateStyle" TargetType="TextBlock">
                <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}"/>
            </Style>
            <Style x:Key="UsageTodayDateStyle" TargetType="TextBlock">
                <Setter Property="Foreground" Value="{ThemeResource AccentTextFillColorPrimaryBrush}"/>
            </Style>
            </ResourceDictionary>
        </Grid.Resources>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <TitleBar x:Name="ManagerTitleBar" Title="G3 Companion" Height="32">
            <TitleBar.LeftHeader>
                <!-- Match the outer padding to the button's 5 DIP inset around its 16 DIP icon. -->
                <Grid Width="80" Height="32" Padding="5,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Button x:Name="ApplyButton" Grid.Column="1" Width="26" Height="28" MinWidth="0" MinHeight="0"
                            HorizontalAlignment="Center" VerticalAlignment="Center"
                            Padding="0" Style="{StaticResource SubtleButtonStyle}"
                            Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                            IsEnabled="False" AutomationProperties.Name="{StaticResource T345}"
                            Click="Apply_Click">
                        <FontIcon Glyph="&#xE73E;" FontSize="16" Width="16" Height="16"/>
                    </Button>
                    <Button x:Name="RestoreButton" Grid.Column="3" Width="26" Height="28" MinWidth="0" MinHeight="0"
                            HorizontalAlignment="Center" VerticalAlignment="Center"
                            Padding="0" Style="{StaticResource SubtleButtonStyle}" IsEnabled="False"
                            AutomationProperties.Name="{StaticResource T346}"
                            Click="Restore_Click">
                        <FontIcon Glyph="&#xE711;" FontSize="16" Width="16" Height="16"/>
                    </Button>
                </Grid>
            </TitleBar.LeftHeader>
        </TitleBar>
        <NavigationView x:Name="Navigation" Grid.Row="1"
                        PaneDisplayMode="Auto" IsPaneOpen="True"
                        ExpandedModeThresholdWidth="900" CompactModeThresholdWidth="0"
                        IsPaneToggleButtonVisible="False" IsBackButtonVisible="Collapsed"
                        IsSettingsVisible="False" AlwaysShowHeader="False"
                        OpenPaneLength="180" CompactPaneLength="48"
                        SelectionChanged="Navigation_SelectionChanged">
            <NavigationView.MenuItems>
                <NavigationViewItem x:Name="GeneralItem" Content="{StaticResource T012}" Tag="general" Height="40">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE713;"/>
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem x:Name="ButtonsItem" Content="{StaticResource T015}" Tag="buttons" Height="40">
                    <NavigationViewItem.Icon>
                        <PathIcon x:Name="ButtonsCursorIcon" Width="20" Height="20" UseLayoutRounding="True" Data="F1 M7.5 2C7.77614 2 8 2.22386 8 2.5V4.5C8 4.77614 7.77614 5 7.5 5C7.22386 5 7 4.77614 7 4.5V2.5C7 2.22386 7.22386 2 7.5 2ZM3.61091 3.61091C3.80618 3.41565 4.12276 3.41565 4.31802 3.61091L5.73223 5.02513C5.9275 5.22039 5.9275 5.53697 5.73223 5.73223C5.53697 5.92749 5.22039 5.92749 5.02513 5.73223L3.61091 4.31802C3.41565 4.12276 3.41565 3.80617 3.61091 3.61091ZM11.3891 3.61091C11.5843 3.80617 11.5843 4.12276 11.3891 4.31802L9.97487 5.73223C9.77961 5.9275 9.46303 5.9275 9.26777 5.73223C9.0725 5.53697 9.0725 5.22039 9.26777 5.02513L10.682 3.61091C10.8772 3.41565 11.1938 3.41565 11.3891 3.61091ZM2 7.5C2 7.22386 2.22386 7 2.5 7H4.5C4.77614 7 5 7.22386 5 7.5C5 7.77614 4.77614 8 4.5 8H2.5C2.22386 8 2 7.77614 2 7.5ZM8.64019 7.2993C7.98886 6.75653 7 7.21968 7 8.06752V17.1693C7 18.0926 8.14454 18.5227 8.75258 17.8278L10.7787 15.5122C11.0635 15.1867 11.475 15 11.9075 15H15.119C16.0543 15 16.4777 13.8305 15.7592 13.2318L8.64019 7.2993ZM8 17.1693L8 8.06752L15.119 14H11.9075C11.1866 14 10.5008 14.3112 10.0261 14.8537L8 17.1693Z"/>
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem x:Name="BatteryItem" Content="{StaticResource T013}" Tag="battery" Height="40">
                    <NavigationViewItem.Icon>
                        <PathIcon Width="20" Height="20" UseLayoutRounding="True" Data="F0 M16 5C17.6569 5 19 6.34315 19 8C19.5523 8 20 8.44772 20 9V11C20 11.5523 19.5523 12 19 12C19 13.6569 17.6569 15 16 15H3C1.34315 15 0 13.6569 0 12V8C0 6.34315 1.34315 5 3 5H16ZM3 6C1.89543 6 1 6.89543 1 8V12C1 13.1046 1.89543 14 3 14H16C17.1046 14 18 13.1046 18 12V8C18 6.89543 17.1046 6 16 6H3ZM12.25 7C12.8023 7 13.25 7.44772 13.25 8V12C13.25 12.5523 12.8023 13 12.25 13H3C2.44772 13 2 12.5523 2 12V8C2 7.44772 2.44772 7 3 7H12.25Z"/>
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem x:Name="AboutItem" Content="{StaticResource T014}" Tag="about" Height="40">
                    <NavigationViewItem.Icon><FontIcon Glyph="&#xE946;"/></NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.MenuItems>
            <NavigationView.PaneFooter>
                <Grid x:Name="BatteryFooterSpacer" Height="124"/>
            </NavigationView.PaneFooter>
            <Grid Background="{ThemeResource SettingsPageBackgroundBrush}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <TextBlock x:Name="PageTitle" Text="{StaticResource T012}" FontSize="30" FontWeight="SemiBold" Margin="28,20,28,24"/>
                <ScrollViewer x:Name="GeneralPage" Grid.Row="1" HorizontalScrollBarVisibility="Disabled"
                              VerticalScrollBarVisibility="Auto" HorizontalScrollMode="Disabled">
                    <ContentControl x:Name="SettingsEditor" IsEnabled="False" IsTabStop="False"
                                    HorizontalContentAlignment="Stretch" Padding="28,0,28,24">
                    <StackPanel x:Name="SettingsContent" Spacing="0">
                        <TextBlock Text="{StaticResource T031}" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,12"/>
                        <Border Style="{StaticResource SettingsCardStyle}">
                        <StackPanel>
                        <Border Style="{StaticResource SettingsRowStyle}">
                            <Grid ColumnSpacing="16">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="260"/></Grid.ColumnDefinitions>
                                <TextBlock Text="{StaticResource T032}" Style="{StaticResource SettingLabelStyle}"/>
                                <TextBlock x:Name="SleepValue" Grid.Column="1" Text="{StaticResource T020_10}" VerticalAlignment="Center"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                <Slider x:Name="SleepSlider" Grid.Column="2" Minimum="1" Maximum="30" Value="10"
                                        IsThumbToolTipEnabled="False"
                                        StepFrequency="1" TickPlacement="None" VerticalAlignment="Center"
                                        AutomationProperties.Name="{StaticResource T347}" ValueChanged="Slider_ValueChanged"/>
                            </Grid>
                        </Border>
                        <Border Style="{StaticResource SettingsSeparatorStyle}"/>
                        <Border Style="{StaticResource SettingsRowStyle}">
                            <Grid ColumnSpacing="16">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="260"/></Grid.ColumnDefinitions>
                                <TextBlock Text="{StaticResource T033}" Style="{StaticResource SettingLabelStyle}"/>
                                <TextBlock x:Name="DebounceValue" Grid.Column="1" Text="4 ms" VerticalAlignment="Center"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                <Slider x:Name="DebounceSlider" Grid.Column="2" Minimum="1" Maximum="14" Value="4"
                                        IsThumbToolTipEnabled="False"
                                        StepFrequency="1" TickPlacement="None" VerticalAlignment="Center"
                                        AutomationProperties.Name="{StaticResource T348}" ValueChanged="Slider_ValueChanged"/>
                            </Grid>
                        </Border>
                        <Border Style="{StaticResource SettingsSeparatorStyle}"/>
                        <Border Style="{StaticResource SettingsRowStyle}">
                            <Grid><TextBlock Text="{StaticResource T034}" Style="{StaticResource SettingLabelStyle}"/>
                                <ToggleSwitch x:Name="AngleToggle" OnContent="" OffContent="" HorizontalAlignment="Right" MinWidth="0" VerticalAlignment="Center"
                                              AutomationProperties.Name="{StaticResource T034}" Toggled="Toggle_Toggled"/>
                            </Grid>
                        </Border>
                        <Border Style="{StaticResource SettingsSeparatorStyle}"/>
                        <Border Style="{StaticResource SettingsRowStyle}">
                            <Grid><TextBlock Text="{StaticResource T035}" Style="{StaticResource SettingLabelStyle}"/>
                                <ToggleSwitch x:Name="RippleToggle" OnContent="" OffContent="" HorizontalAlignment="Right" MinWidth="0" VerticalAlignment="Center"
                                              AutomationProperties.Name="{StaticResource T035}" Toggled="Toggle_Toggled"/>
                            </Grid>
                        </Border>
                        </StackPanel>
                        </Border>
                        <TextBlock Text="{StaticResource T036}" FontSize="14" FontWeight="SemiBold" Margin="0,24,0,12"/>
                        <Border Style="{StaticResource SettingsCardStyle}">
                        <StackPanel>
                        <Border Style="{StaticResource SettingsRowStyle}">
                            <Grid><TextBlock Text="{StaticResource T037}" Style="{StaticResource SettingLabelStyle}"/>
                                <ComboBox x:Name="RateCombo" Width="172" HorizontalAlignment="Right" VerticalAlignment="Center" SelectedIndex="3"
                                          AutomationProperties.Name="{StaticResource T037}" SelectionChanged="Combo_SelectionChanged">
                                    <ComboBoxItem Content="125 Hz"/><ComboBoxItem Content="250 Hz"/>
                                    <ComboBoxItem Content="500 Hz"/><ComboBoxItem Content="1000 Hz"/>
                                </ComboBox>
                            </Grid>
                        </Border>
                        <Border Style="{StaticResource SettingsSeparatorStyle}"/>
                        <Border Style="{StaticResource SettingsRowStyle}">
                            <Grid><TextBlock Text="{StaticResource T038}" Style="{StaticResource SettingLabelStyle}"/>
                                <ComboBox x:Name="CountCombo" Width="172" HorizontalAlignment="Right" VerticalAlignment="Center" SelectedIndex="5"
                                          AutomationProperties.Name="{StaticResource T038}" SelectionChanged="Combo_SelectionChanged">
                                    <ComboBoxItem Content="1"/><ComboBoxItem Content="2"/><ComboBoxItem Content="3"/>
                                    <ComboBoxItem Content="4"/><ComboBoxItem Content="5"/><ComboBoxItem Content="6"/>
                                </ComboBox>
                            </Grid>
                        </Border>
                        <StackPanel x:Name="DpiRows" Spacing="0"/>
                        </StackPanel>
                        </Border>
                    </StackPanel>
                    </ContentControl>
                </ScrollViewer>
                <ScrollViewer x:Name="AboutPage" x:Load="False" Grid.Row="1" Visibility="Collapsed"
                              HorizontalScrollBarVisibility="Disabled" HorizontalScrollMode="Disabled" VerticalScrollBarVisibility="Auto">
                    <StackPanel Padding="28,0,28,24">
                        <Grid ColumnSpacing="16" Margin="0,4,0,28">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="64"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <ContentControl Content="G3 Companion" ContentTemplate="{StaticResource ApplicationIconTemplate}"
                                            Width="64" Height="64" IsTabStop="False" AutomationProperties.Name="{StaticResource T349}"/>
                            <StackPanel Grid.Column="1" Spacing="4" VerticalAlignment="Center">
                                <TextBlock Text="G3 Companion" FontSize="24" FontWeight="Medium"/>
                                <TextBlock Text="{StaticResource T285}" FontSize="12"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Grid>
                        <TextBlock Text="{StaticResource T286}" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,12"/>
                        <Border Style="{StaticResource SettingsCardStyle}">
                            <Border Style="{StaticResource SettingsRowStyle}">
                                <Grid>
                                    <TextBlock Text="{StaticResource T287}" Style="{StaticResource SettingLabelStyle}"/>
                                    <ToggleSwitch x:Name="ProgramLoggingToggle" OnContent="" OffContent=""
                                                  HorizontalAlignment="Right" VerticalAlignment="Center" MinWidth="0"
                                                  AutomationProperties.Name="{StaticResource T287}" Toggled="ProgramLogging_Toggled"/>
                                </Grid>
                            </Border>
                        </Border>
                        <TextBlock Text="{StaticResource T288}" FontSize="14" FontWeight="SemiBold" Margin="0,24,0,12"/>
                        <HyperlinkButton Content="{StaticResource T289}" NavigateUri="https://github.com/SsenNChan/G3-Companion"
                                         HorizontalAlignment="Left" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"/>
                    </StackPanel>
                </ScrollViewer>
                <ScrollViewer x:Name="ButtonsPage" Grid.Row="1" Visibility="Collapsed"
                              HorizontalScrollBarVisibility="Disabled" HorizontalScrollMode="Disabled" VerticalScrollBarVisibility="Auto">
                    <StackPanel Padding="28,0,28,24">
                        <Border BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="0,1,0,1">
                            <Canvas x:Name="ButtonPreview" Width="490" Height="170.2" HorizontalAlignment="Center">
                                <Canvas.Clip><RectangleGeometry Rect="0,0,490,170.2"/></Canvas.Clip>
                                <Canvas Width="171.8" Height="170.2" Canvas.Left="159.1">
                                    <Canvas.Clip><RectangleGeometry Rect="0,0,171.8,170.2"/></Canvas.Clip>
